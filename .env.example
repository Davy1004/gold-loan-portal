# Copy to .env (never commit .env). Everything here is optional: the defaults run with zero setup.

PORT=4000

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PostgreSQL engine (PGlite, stored in server/.data).
# For a real PostgreSQL server:   docker compose up -d   then uncomment:
# DATABASE_URL=postgres://gold:gold@localhost:5432/goldloan

# --- AI agent ---------------------------------------------------------------
# mock   (default) deterministic scripted model: no key, used by `npm test` and `npm run eval`
# gemini free-tier Gemini via its OpenAI-compatible endpoint (needs GEMINI_API_KEY)
# ollama local model via Ollama (no key; needs `ollama serve` and a tool-calling model)
LLM_PROVIDER=mock

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Misc -------------------------------------------------------------------
# Mock 24K gold rate in rupees per gram (the brief's value)
RATE_24K_PER_GRAM=7000
CORS_ORIGIN=http://localhost:5173
